# Carpool Mauritius version C is a static demo.
# The GitHub Pages build does not read this file and needs no secrets.
# Copy to .env.local only if you rebuild with an optional browser map key.

# Browser map key. Leave empty. The demo uses a local gazetteer either way.
# Restrict any real key by HTTP referrer to the Pages origin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Not used by the static demo. Named so a later server build has a place to put them.
# Do not commit real values.
GOOGLE_MAPS_API_KEY=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
